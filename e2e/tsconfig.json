{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@e2e/test": ["./playwright/index.ts"],
      "@e2e/pages": ["./pages/index.ts"],
      "@e2e/support": ["./support/index.ts"],
      "@e2e/data": ["./data/index.ts"],
      "@e2e/constants": ["./constants/index.ts"],
      "@e2e/servers": ["./servers/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.js"],
  "exclude": ["**/node_modules/**", "**/test-data/**", "**/init-user-data/**", "playwright/codegen.ts", "playwright/electron.ts"]
}
