meta {
  name: BidiHello
  type: grpc
  seq: 7
}

grpc {
  url: {{host}}
  method: /hello.HelloService/BidiHello
  body: grpc
  auth: none
  methodType: bidi-streaming
}

body:grpc {
  name: message 1
  content: '''
    {
      "greeting": "bidi-1"
    }
  '''
}

body:grpc {
  name: message 2
  content: '''
    {
      "greeting": "bidi-2"
    }
  '''
}

body:grpc {
  name: message 3
  content: '''
    {
      "greeting": "bidi-3"
    }
  '''
}

script:grpc:after-call-end {
  test('both streamed messages reach the hook, in order', () => {
    expect(bru.grpc.request.messages.count()).to.equal(2);
    expect(bru.grpc.request.messages.map((message) => message.data.greeting)).to.eql(['bidi-1', 'bidi-2']);
  });

  test('server replied to each message', () => {
    expect(bru.grpc.response.messages.count()).to.equal(2);
  });

  test('call finished with OK', () => {
    expect(bru.grpc.response.statusCode).to.equal(0);
  });
}
