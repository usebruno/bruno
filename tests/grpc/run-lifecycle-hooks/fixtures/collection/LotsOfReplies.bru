meta {
  name: LotsOfReplies
  type: grpc
  seq: 3
}

grpc {
  url: {{host}}
  method: /hello.HelloService/LotsOfReplies
  body: grpc
  auth: none
  methodType: server-streaming
}

body:grpc {
  name: message 1
  content: '''
    {
      "greeting": "stream"
    }
  '''
}

script:grpc:before-call-start {
  bru.setVar('replyCount', '');
}

script:grpc:after-call-end {
  test('the hook sees the one message the server stream sent', () => {
    expect(bru.grpc.req.messages.count()).to.equal(1);
    expect(bru.grpc.req.messages.get(0).data.greeting).to.equal('stream');
  });

  bru.setVar('replyCount', String(bru.grpc.res.messages.count()));
}
