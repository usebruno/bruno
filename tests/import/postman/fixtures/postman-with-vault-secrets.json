{
  "info": {
    "_postman_id": "9f2c1b7e-4a31-4d52-9a6e-vault0000001",
    "name": "Vault Secrets Test",
    "description": "Exercises Postman vault references and the pm.vault script API for the Bruno import translation layer.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{vault:api-key}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://httpbin.org"
    },
    {
      "key": "plainVar",
      "value": "not-a-secret"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// collection-level: direct read",
          "const collectionKey = pm.vault.get('api-key');",
          "console.log('collection pre-request', collectionKey);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Header and query references",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// awaited read - the await should survive translation",
              "const apiKey = await pm.vault.get('api-key');",
              "const tenant = await pm.vault.get('tenant.id');",
              "console.log('resolved', apiKey, tenant);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{vault:api-key}}",
            "type": "text"
          },
          {
            "key": "X-Tenant",
            "value": "{{vault:tenant.id}}",
            "type": "text"
          },
          {
            "key": "X-Plain",
            "value": "{{plainVar}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/get?tenant={{vault:tenant.id}}",
          "host": ["{{baseUrl}}"],
          "path": ["get"],
          "query": [
            {
              "key": "tenant",
              "value": "{{vault:tenant.id}}"
            }
          ]
        }
      }
    },
    {
      "name": "JSON body reference (aliased vault)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// alias form - needs pm.vault in varInitsToReplace",
              "const vault = pm.vault;",
              "const dbPassword = vault.get('db password');",
              "pm.environment.set('db_password_length', String(dbPassword.length));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"password\": \"{{vault:db password}}\",\n  \"tenant\": \"{{vault:tenant.id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/post",
          "host": ["{{baseUrl}}"],
          "path": ["post"]
        }
      }
    },
    {
      "name": "Form body reference (destructured + legacy namespace)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// destructured form",
              "const { vault } = pm;",
              "const serviceToken = vault.get('service/token');",
              "// legacy postman.* namespace",
              "const tenantId = postman.vault.get('tenant.id');",
              "console.log(serviceToken, tenantId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "token",
              "value": "{{vault:service/token}}",
              "type": "text"
            },
            {
              "key": "scope",
              "value": "read",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/post",
          "host": ["{{baseUrl}}"],
          "path": ["post"]
        }
      }
    },
    {
      "name": "Rotation folder",
      "item": [
        {
          "name": "Write and clear secrets",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.vault.set('api-key', 'rotated-value');",
                  "pm.vault.unset('service/token');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{vault:api-key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/headers",
              "host": ["{{baseUrl}}"],
              "path": ["headers"]
            }
          }
        }
      ]
    }
  ]
}
