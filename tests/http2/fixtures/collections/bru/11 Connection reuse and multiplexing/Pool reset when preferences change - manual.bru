meta {
  name: Pool reset when preferences change - manual
  type: http
  seq: 8
  tags: [
    manual
  ]
}

get {
  url: {{dual}}/echo
  body: none
  auth: inherit
}

tests {
  // ---- testbed helpers ----
  var MODE = bru.getEnvVar("mode");
  var CLIENT = bru.getEnvVar("client") || "app";
  function expectedProtocol(kind, opts) {
    var proxied = !!(opts && opts.proxied);
    var cliProxyGap = false; // CLI tunnels HTTP/2 through proxies too (parity with the app)
    if (kind === "cleartext") return MODE === "http2" ? "fail" : "1.1"; // http2 sends h2c preface to an h1 server -> fails
    if (kind === "h2c") return MODE === "http2" ? "2.0" : "fail";       // h2c server: http2 -> prior knowledge; else an h1 client is rejected
    if (kind === "h2only") return MODE === "http1" || cliProxyGap ? "fail" : "2.0";
    if (kind === "h1only") return MODE === "http2" ? "fail" : "1.1";
    if (MODE === "http1" || cliProxyGap) return "1.1";
    return "2.0";
  }
  function json() {
    var b = res.getBody();
    if (typeof b === "string") { try { return JSON.parse(b); } catch (e) { return {}; } }
    return b || {};
  }
  function isH2() { return json().protocol === "2.0"; }
  // ---- end helpers ----
  test("status 200", function () { expect(res.getStatus()).to.equal(200); });
  test("record connection id", function () { console.log("connection id: " + res.getHeader("x-connection-id") + " over HTTP/" + res.getHeader("x-protocol")); });
}

settings {
  encodeUrl: true
}

docs {
  **Manual.**
  1. Send this request and note `x-connection-id`.
  2. Change a proxy or certificate preference and save. That calls `clearAgentCache()` + `closeAllSessions()`.
  3. Send again. Expect a **new** connection id, and `◇ h2 session sN closed` in the server log at step 2.
  4. Switch **HTTP version** between http2 → auto → http1 and send after each change. The protocol must follow the preference immediately, with no app restart needed.
}
