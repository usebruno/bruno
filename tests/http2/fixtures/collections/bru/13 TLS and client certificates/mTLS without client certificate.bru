meta {
  name: mTLS without client certificate
  type: http
  seq: 4
  tags: [
    ci-skip
  ]
}

get {
  url: {{mtlsNoCert}}/echo
  body: none
  auth: inherit
}

script:pre-request {
  bru.setVar("outcome", JSON.stringify({ request: "mTLS without client certificate", ok: false, error: "no response (request failed before post-response ran)" }));
  if (typeof req.onFail === "function") {
    req.onFail(function (err) {
      var msg = err ? ((err.code ? err.code + ": " : "") + (err.message || String(err))) : "unknown error";
      bru.setVar("outcome", JSON.stringify({ request: "mTLS without client certificate", ok: false, error: msg }));
    });
  }
  
  bru.runner.skipRequest()
}

script:post-response {
  var __b = res.getBody();
  var __j = {};
  if (typeof __b === "string") { try { __j = JSON.parse(__b); } catch (e) { __j = {}; } } else { __j = __b || {}; }
  bru.setVar("outcome", JSON.stringify({
    request: "mTLS without client certificate",
    ok: true,
    status: res.getStatus(),
    protocol: res.getHeader("x-protocol") || __j.protocol || null,
    server: res.getHeader("x-server") || __j.server || null,
    connectionId: res.getHeader("x-connection-id") || null,
    echoHeaders: __j.headers || null,
    bodyPreview: (typeof __b === "string" ? __b : JSON.stringify(__b) || "").slice(0, 300)
  }));
}

settings {
  encodeUrl: true
  timeout: 5000
}

docs {
  No certificate is configured for :8449, so the server rejects the handshake. Expect a clear TLS error in every mode.
  
  > **Outcome case.** This request may fail *by design*. Its result is recorded in the runtime var `outcome` and asserted by the next request, **↳ verify: mTLS without client certificate**. Run both together (the folder runner does this).
}
