meta {
  name: PFX client certificate - manual
  type: http
  seq: 6
  tags: [
    manual
  ]
}

get {
  url: {{mtls}}/echo
  body: none
  auth: inherit
}

tests {
  // ---- testbed helpers ----
  var MODE = bru.getEnvVar("mode");
  var CLIENT = bru.getEnvVar("client") || "app";
  function expectedProtocol(kind, opts) {
    var proxied = !!(opts && opts.proxied);
    var cliProxyGap = false; // CLI tunnels HTTP/2 through proxies too (parity with the app)
    if (kind === "cleartext") return MODE === "http2" ? "fail" : "1.1"; // http2 sends h2c preface to an h1 server -> fails
    if (kind === "h2c") return MODE === "http2" ? "2.0" : "fail";       // h2c server: http2 -> prior knowledge; else an h1 client is rejected
    if (kind === "h2only") return MODE === "http1" || cliProxyGap ? "fail" : "2.0";
    if (kind === "h1only") return MODE === "http2" ? "fail" : "1.1";
    if (MODE === "http1" || cliProxyGap) return "1.1";
    return "2.0";
  }
  function json() {
    var b = res.getBody();
    if (typeof b === "string") { try { return JSON.parse(b); } catch (e) { return {}; } }
    return b || {};
  }
  function isH2() { return json().protocol === "2.0"; }
  // ---- end helpers ----
  test("status 200", function () { expect(res.getStatus()).to.equal(200); });
  test("record CN + connection", function () { console.log("CN " + json().tls.clientCertificate.subject + " conn " + res.getHeader("x-connection-id")); });
}

settings {
  encodeUrl: true
}

docs {
  **Manual.** Collection Settings → Client Certificates: replace the PEM entry for `localhost:8446` with **PFX** `../server/certs/client.pfx`, passphrase `bruno`. Send. Expect 200 and CN `bruno-qa-client`, over h2 in http2/auto mode.
  
  Then switch to `client2.pfx` (CN `bruno-qa-client-2`). Expect the new CN **and a new connection id**: the TLS identity is fixed per session, so the pool must not reuse the old one.
}
