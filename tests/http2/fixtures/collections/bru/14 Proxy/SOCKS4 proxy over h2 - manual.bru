meta {
  name: SOCKS4 proxy over h2 - manual
  type: http
  seq: 10
  tags: [
    ci-skip
  ]
}

get {
  url: {{proxied}}/echo
  body: none
  auth: inherit
}

script:pre-request {
  // Retarget the collection proxy at a local SOCKS5 proxy for this request only.
  bru.setVar("proxyProtocol", "socks4");
  bru.setVar("proxyPort", bru.getEnvVar("socksPort") || "1080");
}

script:post-response {
  // Restore the collection defaults (http proxy on {{proxyPort}}=3128).
  bru.deleteVar("proxyProtocol");
  bru.deleteVar("proxyPort");
}

tests {
  // ---- testbed helpers ----
  var MODE = bru.getEnvVar("mode");
  var CLIENT = bru.getEnvVar("client") || "app";
  function expectedProtocol(kind, opts) {
    var proxied = !!(opts && opts.proxied);
    var cliProxyGap = false; // CLI tunnels HTTP/2 through proxies too (parity with the app)
    if (kind === "cleartext") return MODE === "http2" ? "fail" : "1.1"; // http2 sends h2c preface to an h1 server -> fails
    if (kind === "h2c") return MODE === "http2" ? "2.0" : "fail";       // h2c server: http2 -> prior knowledge; else an h1 client is rejected
    if (kind === "h2only") return MODE === "http1" || cliProxyGap ? "fail" : "2.0";
    if (kind === "h1only") return MODE === "http2" ? "fail" : "1.1";
    if (MODE === "http1" || cliProxyGap) return "1.1";
    return "2.0";
  }
  function json() {
    var b = res.getBody();
    if (typeof b === "string") { try { return JSON.parse(b); } catch (e) { return {}; } }
    return b || {};
  }
  // ---- end helpers ----
  test("status 200", function () { expect(res.getStatus()).to.equal(200); });
  var exp = expectedProtocol("dual", {"proxied":true});
  test("served over HTTP/" + exp + " through SOCKS4 (mode=" + MODE + ", client=" + CLIENT + ")", function () {
    expect(exp, "this request should have FAILED under mode=" + MODE + " but got a response").to.not.equal("fail");
    expect(json().protocol).to.equal(exp);
    expect(res.getHeader("x-protocol")).to.equal(exp);
  });
  test("authority is proxied.localhost:8443", function () { expect(json().authority).to.equal("proxied.localhost:8443"); });
}

settings {
  encodeUrl: true
}

docs {
  **Manual.** Needs a local SOCKS5 proxy on `{{socksPort}}` (default 1080). Start one, then run:

  - `ssh -D 1080 -N -v localhost`  (SOCKS4 + SOCKS5, no auth; `-v` logs each tunnel), **or**
  - `pip install pproxy --break-system-packages && pproxy -l socks://:1080 -vv`

  The pre-request retargets the collection proxy at `socks4://localhost:{{socksPort}}`. SOCKS4 has no
  password auth, so only the `bruno` userId is sent (ignored by a no-auth proxy like `ssh -D`). Expect the echo
  over **HTTP/2** (`x-protocol: 2.0`) in http2/auto, HTTP/1.1 in the http1 env. The proxy's own log
  (ssh `-v` / pproxy `-vv`) shows the outgoing connection to `proxied.localhost:8443` — that's the proof
  it tunneled over SOCKS rather than connecting directly. There is no server-side SOCKS counter.
}
