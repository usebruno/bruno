meta {
  name: Proxy requiring auth (wrong password)
  type: http
  seq: 6
  tags: [
    ci-skip
  ]
}

get {
  url: {{proxied}}/echo?auth=bad
  body: none
  auth: inherit
}

script:pre-request {
  bru.setVar("outcome", JSON.stringify({ request: "Proxy requiring auth (wrong password)", ok: false, error: "no response (request failed before post-response ran)" }));
  if (typeof req.onFail === "function") {
    req.onFail(function (err) {
      var msg = err ? ((err.code ? err.code + ": " : "") + (err.message || String(err))) : "unknown error";
      bru.setVar("outcome", JSON.stringify({ request: "Proxy requiring auth (wrong password)", ok: false, error: msg }));
    });
  }
  
  bru.setVar("proxyPort", "3129"); bru.setVar("proxyPass", "WRONG");
}

script:post-response {
  var __b = res.getBody();
  var __j = {};
  if (typeof __b === "string") { try { __j = JSON.parse(__b); } catch (e) { __j = {}; } } else { __j = __b || {}; }
  bru.setVar("outcome", JSON.stringify({
    request: "Proxy requiring auth (wrong password)",
    ok: true,
    status: res.getStatus(),
    protocol: res.getHeader("x-protocol") || __j.protocol || null,
    server: res.getHeader("x-server") || __j.server || null,
    connectionId: res.getHeader("x-connection-id") || null,
    echoHeaders: __j.headers || null,
    bodyPreview: (typeof __b === "string" ? __b : JSON.stringify(__b) || "").slice(0, 300)
  }));
  
  bru.deleteVar("proxyPort"); bru.deleteVar("proxyPass");
}

settings {
  encodeUrl: true
  timeout: 8000
}

docs {
  The proxy answers 407. **http2 (forced)**: the tunnel is refused, so expect a clear `proxy CONNECT refused (407)` error. **auto**: the probe fails, Bruno falls back to h1, and the h1 agent surfaces the 407. Either way the request must not succeed. **The verifier resets proxyPort/proxyPass**; if this request errors, its post-response never runs.
  
  > **Outcome case.** This request may fail *by design*. Its result is recorded in the runtime var `outcome` and asserted by the next request, **↳ verify: Proxy requiring auth (wrong password)**. Run both together (the folder runner does this).
}
