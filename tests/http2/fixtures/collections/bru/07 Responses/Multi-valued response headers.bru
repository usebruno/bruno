meta {
  name: Multi-valued response headers
  type: http
  seq: 32
}

get {
  url: {{dual}}/headers/multi
  body: none
  auth: inherit
}

tests {
  // ---- testbed helpers ----
  var MODE = bru.getEnvVar("mode");
  var CLIENT = bru.getEnvVar("client") || "app";
  function expectedProtocol(kind, opts) {
    var proxied = !!(opts && opts.proxied);
    var cliProxyGap = false; // CLI tunnels HTTP/2 through proxies too (parity with the app)
    if (kind === "cleartext") return MODE === "http2" ? "fail" : "1.1"; // http2 sends h2c preface to an h1 server -> fails
    if (kind === "h2c") return MODE === "http2" ? "2.0" : "fail";       // h2c server: http2 -> prior knowledge; else an h1 client is rejected
    if (kind === "h2only") return MODE === "http1" || cliProxyGap ? "fail" : "2.0";
    if (kind === "h1only") return MODE === "http2" ? "fail" : "1.1";
    if (MODE === "http1" || cliProxyGap) return "1.1";
    return "2.0";
  }
  function json() {
    var b = res.getBody();
    if (typeof b === "string") { try { return JSON.parse(b); } catch (e) { return {}; } }
    return b || {};
  }
  function isH2() { return json().protocol === "2.0"; }
  // ---- end helpers ----
  test("status 200", function () { expect(res.getStatus()).to.equal(200); });
  test("3 set-cookie values", function () {
    var sc = res.getHeader("set-cookie");
    expect(Array.isArray(sc) ? sc.length : String(sc).split(/,(?=\s*multi_)/).length).to.equal(3);
  });
  test("x-multi preserved (record shape)", function () { console.log("x-multi = " + JSON.stringify(res.getHeader("x-multi"))); expect(String(res.getHeader("x-multi"))).to.contain("second"); });
}

settings {
  encodeUrl: true
}

docs {
  Three `set-cookie` values and a repeated `x-multi`. On h2 they arrive as separate header fields. **Manual:** the Headers tab should show all three cookies.
}
