meta {
  name: Content-Length larger than body
  type: http
  seq: 36
  tags: [
    ci-skip
  ]
}

get {
  url: {{dual}}/content-length-mismatch
  body: none
  auth: inherit
}

script:pre-request {
  bru.setVar("outcome", JSON.stringify({ request: "Content-Length larger than body", ok: false, error: "no response (request failed before post-response ran)" }));
  if (typeof req.onFail === "function") {
    req.onFail(function (err) {
      var msg = err ? ((err.code ? err.code + ": " : "") + (err.message || String(err))) : "unknown error";
      bru.setVar("outcome", JSON.stringify({ request: "Content-Length larger than body", ok: false, error: msg }));
    });
  }
}

script:post-response {
  var __b = res.getBody();
  var __j = {};
  if (typeof __b === "string") { try { __j = JSON.parse(__b); } catch (e) { __j = {}; } } else { __j = __b || {}; }
  bru.setVar("outcome", JSON.stringify({
    request: "Content-Length larger than body",
    ok: true,
    status: res.getStatus(),
    protocol: res.getHeader("x-protocol") || __j.protocol || null,
    server: res.getHeader("x-server") || __j.server || null,
    connectionId: res.getHeader("x-connection-id") || null,
    echoHeaders: __j.headers || null,
    bodyPreview: (typeof __b === "string" ? __b : JSON.stringify(__b) || "").slice(0, 300)
  }));
}

settings {
  encodeUrl: true
  timeout: 10000
}

docs {
  Malformed response: `content-length: 100`, but only 5 bytes followed by end of stream. A client should report it clearly (error, or truncated-body warning), never hang and never present it as a clean 200 with no hint.
  
  > **Outcome case.** This request may fail *by design*. Its result is recorded in the runtime var `outcome` and asserted by the next request, **↳ verify: Content-Length larger than body**. Run both together (the folder runner does this).
}
