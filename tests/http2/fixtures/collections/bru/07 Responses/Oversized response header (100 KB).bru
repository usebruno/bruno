meta {
  name: Oversized response header (100 KB)
  type: http
  seq: 30
  tags: [
    ci-skip
  ]
}

get {
  url: {{dual}}/headers/large-response?size=102400
  body: none
  auth: inherit
}

script:pre-request {
  bru.setVar("outcome", JSON.stringify({ request: "Oversized response header (100 KB)", ok: false, error: "no response (request failed before post-response ran)" }));
  if (typeof req.onFail === "function") {
    req.onFail(function (err) {
      var msg = err ? ((err.code ? err.code + ": " : "") + (err.message || String(err))) : "unknown error";
      bru.setVar("outcome", JSON.stringify({ request: "Oversized response header (100 KB)", ok: false, error: msg }));
    });
  }
}

script:post-response {
  var __b = res.getBody();
  var __j = {};
  if (typeof __b === "string") { try { __j = JSON.parse(__b); } catch (e) { __j = {}; } } else { __j = __b || {}; }
  bru.setVar("outcome", JSON.stringify({
    request: "Oversized response header (100 KB)",
    ok: true,
    status: res.getStatus(),
    protocol: res.getHeader("x-protocol") || __j.protocol || null,
    server: res.getHeader("x-server") || __j.server || null,
    connectionId: res.getHeader("x-connection-id") || null,
    echoHeaders: __j.headers || null,
    bodyPreview: (typeof __b === "string" ? __b : JSON.stringify(__b) || "").slice(0, 300)
  }));
}

settings {
  encodeUrl: true
  timeout: 10000
}

docs {
  Larger than typical client limits (h1 16 KiB; h2 depends on the client's SETTINGS_MAX_HEADER_LIST_SIZE). Bruno should either accept it or fail with a **clear** error. It must not hang or crash. Record whether h1 and h2 differ.
  
  > **Outcome case.** This request may fail *by design*. Its result is recorded in the runtime var `outcome` and asserted by the next request, **↳ verify: Oversized response header (100 KB)**. Run both together (the folder runner does this).
}
