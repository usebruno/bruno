script:pre-request {
  bru.setVar("outcome", JSON.stringify({ request: "GOAWAY refusing this stream", ok: false, error: "no response (request failed before post-response ran)" }));
  if (typeof req.onFail === "function") {
    req.onFail(function (err) {
      var msg = err ? ((err.code ? err.code + ": " : "") + (err.message || String(err))) : "unknown error";
      bru.setVar("outcome", JSON.stringify({ request: "GOAWAY refusing this stream", ok: false, error: msg }));
    });
