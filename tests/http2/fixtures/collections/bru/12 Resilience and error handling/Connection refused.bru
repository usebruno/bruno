meta {
  name: Connection refused
  type: http
  seq: 22
  tags: [
    ci-skip
  ]
}

get {
  url: https://localhost:8999/echo
  body: none
  auth: inherit
}

script:pre-request {
  bru.setVar("outcome", JSON.stringify({ request: "Connection refused", ok: false, error: "no response (request failed before post-response ran)" }));
  if (typeof req.onFail === "function") {
    req.onFail(function (err) {
      var msg = err ? ((err.code ? err.code + ": " : "") + (err.message || String(err))) : "unknown error";
      bru.setVar("outcome", JSON.stringify({ request: "Connection refused", ok: false, error: msg }));
    });
  }
}

script:post-response {
  var __b = res.getBody();
  var __j = {};
  if (typeof __b === "string") { try { __j = JSON.parse(__b); } catch (e) { __j = {}; } } else { __j = __b || {}; }
  bru.setVar("outcome", JSON.stringify({
    request: "Connection refused",
    ok: true,
    status: res.getStatus(),
    protocol: res.getHeader("x-protocol") || __j.protocol || null,
    server: res.getHeader("x-server") || __j.server || null,
    connectionId: res.getHeader("x-connection-id") || null,
    echoHeaders: __j.headers || null,
    bodyPreview: (typeof __b === "string" ? __b : JSON.stringify(__b) || "").slice(0, 300)
  }));
}

settings {
  encodeUrl: true
  timeout: 5000
}

docs {
  Nothing listens on 8999. Expect `ECONNREFUSED` in every mode. In auto, the ALPN probe fails, Bruno falls back to the h1 path, and that surfaces the real error.
  
  > **Outcome case.** This request may fail *by design*. Its result is recorded in the runtime var `outcome` and asserted by the next request, **↳ verify: Connection refused**. Run both together (the folder runner does this).
}
