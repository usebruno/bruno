meta {
  name: bru.sendRequest with basic auth option
  type: http
  seq: 4
}

get {
  url: {{dual}}/echo
  body: none
  auth: inherit
}

script:pre-request {
  var r = await bru.sendRequest({ method: "GET", url: bru.interpolate("{{dual}}/basic-auth/sr/pw"), auth: { username: "sr", password: "pw" } }).catch(function (e) { return e.response || { status: "error", data: {} }; });
  bru.setVar("srAuthStatus", r.status);
  bru.setVar("srAuthProtocol", r.data && r.data.protocol);
}

tests {
  // ---- testbed helpers ----
  var MODE = bru.getEnvVar("mode");
  var CLIENT = bru.getEnvVar("client") || "app";
  function expectedProtocol(kind, opts) {
    var proxied = !!(opts && opts.proxied);
    var cliProxyGap = false; // CLI tunnels HTTP/2 through proxies too (parity with the app)
    if (kind === "cleartext") return MODE === "http2" ? "fail" : "1.1"; // http2 sends h2c preface to an h1 server -> fails
    if (kind === "h2c") return MODE === "http2" ? "2.0" : "fail";       // h2c server: http2 -> prior knowledge; else an h1 client is rejected
    if (kind === "h2only") return MODE === "http1" || cliProxyGap ? "fail" : "2.0";
    if (kind === "h1only") return MODE === "http2" ? "fail" : "1.1";
    if (MODE === "http1" || cliProxyGap) return "1.1";
    return "2.0";
  }
  function json() {
    var b = res.getBody();
    if (typeof b === "string") { try { return JSON.parse(b); } catch (e) { return {}; } }
    return b || {};
  }
  function isH2() { return json().protocol === "2.0"; }
  // ---- end helpers ----
  test("authenticated via auth option (status 200)", function () { expect(Number(bru.getVar("srAuthStatus"))).to.equal(200); });
  test("record protocol", function () { console.log("sendRequest+auth over HTTP/" + bru.getVar("srAuthProtocol")); });
}

settings {
  encodeUrl: true
}

docs {
  axios `auth` option → the h2 transport never sees `options.auth`, so the preparer must build the header itself (`applyBasicAuthHeader`).
}
