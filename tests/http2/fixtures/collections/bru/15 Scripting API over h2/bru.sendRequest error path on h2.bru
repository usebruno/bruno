meta {
  name: bru.sendRequest error path on h2
  type: http
  seq: 5
  tags: [
    ci-skip
  ]
}

get {
  url: {{dual}}/echo
  body: none
  auth: inherit
}

script:pre-request {
  var outcome;
  try { await bru.sendRequest({ method: "GET", url: bru.interpolate("{{dual}}/status/404") }); outcome = "no-throw"; }
  catch (e) { outcome = JSON.stringify({ status: (e.response && e.response.status) || e.status, statusText: e.response && e.response.statusText, keys: Object.keys(e || {}) }); }
  bru.setVar("srError", outcome);
}

tests {
  // ---- testbed helpers ----
  var MODE = bru.getEnvVar("mode");
  var CLIENT = bru.getEnvVar("client") || "app";
  function expectedProtocol(kind, opts) {
    var proxied = !!(opts && opts.proxied);
    var cliProxyGap = false; // CLI tunnels HTTP/2 through proxies too (parity with the app)
    if (kind === "cleartext") return MODE === "http2" ? "fail" : "1.1"; // http2 sends h2c preface to an h1 server -> fails
    if (kind === "h2c") return MODE === "http2" ? "2.0" : "fail";       // h2c server: http2 -> prior knowledge; else an h1 client is rejected
    if (kind === "h2only") return MODE === "http1" || cliProxyGap ? "fail" : "2.0";
    if (kind === "h1only") return MODE === "http2" ? "fail" : "1.1";
    if (MODE === "http1" || cliProxyGap) return "1.1";
    return "2.0";
  }
  function json() {
    var b = res.getBody();
    if (typeof b === "string") { try { return JSON.parse(b); } catch (e) { return {}; } }
    return b || {};
  }
  function isH2() { return json().protocol === "2.0"; }
  // ---- end helpers ----
  test("404 rejects with the status available", function () {
    var o = JSON.parse(bru.getVar("srError"));
    expect(o.status).to.equal(404);
  });
  test("record statusText on scripted error", function () { console.log("scripted 404: " + bru.getVar("srError")); });
}

settings {
  encodeUrl: true
}
