meta {
  name: bru.sendRequest over h2
  type: http
  seq: 3
}

get {
  url: {{dual}}/echo
  body: none
  auth: inherit
}

script:pre-request {
  var r = await bru.sendRequest({ method: "POST", url: bru.interpolate("{{dual}}/echo"), headers: { "content-type": "application/json", "Connection": "keep-alive" }, data: { from: "script" } });
  bru.setVar("scriptedProtocol", r.data.protocol);
  bru.setVar("scriptedStatusText", r.statusText || "");
  bru.setVar("scriptedBody", JSON.stringify(r.data.body.json));
}

tests {
  // ---- testbed helpers ----
  var MODE = bru.getEnvVar("mode");
  var CLIENT = bru.getEnvVar("client") || "app";
  function expectedProtocol(kind, opts) {
    var proxied = !!(opts && opts.proxied);
    var cliProxyGap = false; // CLI tunnels HTTP/2 through proxies too (parity with the app)
    if (kind === "cleartext") return MODE === "http2" ? "fail" : "1.1"; // http2 sends h2c preface to an h1 server -> fails
    if (kind === "h2c") return MODE === "http2" ? "2.0" : "fail";       // h2c server: http2 -> prior knowledge; else an h1 client is rejected
    if (kind === "h2only") return MODE === "http1" || cliProxyGap ? "fail" : "2.0";
    if (kind === "h1only") return MODE === "http2" ? "fail" : "1.1";
    if (MODE === "http1" || cliProxyGap) return "1.1";
    return "2.0";
  }
  function json() {
    var b = res.getBody();
    if (typeof b === "string") { try { return JSON.parse(b); } catch (e) { return {}; } }
    return b || {};
  }
  function isH2() { return json().protocol === "2.0"; }
  // ---- end helpers ----
  test("scripted request protocol HTTP/" + expectedProtocol("dual") + " (mode=" + MODE + ", client=" + CLIENT + ")", function () { expect(bru.getVar("scriptedProtocol")).to.equal(expectedProtocol("dual")); });
  test("scripted body intact", function () { expect(JSON.parse(bru.getVar("scriptedBody"))).to.eql({ from: "script" }); });
  test("scripted statusText (record)", function () { console.log("sendRequest statusText: '" + bru.getVar("scriptedStatusText") + "'"); });
}

settings {
  encodeUrl: true
}

docs {
  **Known gap:** in `bru run` (CLI), `bru.sendRequest` has no HTTP/2 hook and always uses HTTP/1.1. The protocol test is written for the desired behaviour (parity with the app), so it fails in CLI http2/auto runs until that gap is closed.
}
