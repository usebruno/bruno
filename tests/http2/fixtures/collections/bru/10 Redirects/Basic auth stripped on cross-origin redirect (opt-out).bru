meta {
  name: Basic auth stripped on cross-origin redirect (opt-out)
  type: http
  seq: 17
  tags: [
    ci-skip
  ]
}

get {
  url: {{dual}}/redirect-to?url=https://h2.localhost:8443/echo
  body: none
  auth: basic
}

auth:basic {
  username: leak
  password: check
}

tests {
  // ---- testbed helpers ----
  var MODE = bru.getEnvVar("mode");
  var CLIENT = bru.getEnvVar("client") || "app";
  function expectedProtocol(kind, opts) {
    var proxied = !!(opts && opts.proxied);
    var cliProxyGap = false; // CLI tunnels HTTP/2 through proxies too (parity with the app)
    if (kind === "cleartext") return MODE === "http2" ? "fail" : "1.1"; // http2 sends h2c preface to an h1 server -> fails
    if (kind === "h2c") return MODE === "http2" ? "2.0" : "fail";       // h2c server: http2 -> prior knowledge; else an h1 client is rejected
    if (kind === "h2only") return MODE === "http1" || cliProxyGap ? "fail" : "2.0";
    if (kind === "h1only") return MODE === "http2" ? "fail" : "1.1";
    if (MODE === "http1" || cliProxyGap) return "1.1";
    return "2.0";
  }
  function json() {
    var b = res.getBody();
    if (typeof b === "string") { try { return JSON.parse(b); } catch (e) { return {}; } }
    return b || {};
  }
  function isH2() { return json().protocol === "2.0"; }
  // ---- end helpers ----
  test("status 200", function () { expect(res.getStatus()).to.equal(200); });
  test("authorization not forwarded to h2.localhost", function () { expect(json().headers).to.not.have.property("authorization"); });
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}

docs {
  On h2, Bruno moves Basic credentials into an explicit `Authorization` header before the request leaves (axios would otherwise pass them as the `auth` option). Check that the opt-out still strips that header for a different host (h2.localhost ≠ localhost). Security-relevant.
}
