meta {
  name: Redirect h2 server to h1-only server
  type: http
  seq: 8
  tags: [
    ci-skip
  ]
}

get {
  url: {{dual}}/redirect-to?url={{h1only}}/echo
  body: none
  auth: inherit
}

script:pre-request {
  bru.setVar("outcome", JSON.stringify({ request: "Redirect h2 server to h1-only server", ok: false, error: "no response (request failed before post-response ran)" }));
  if (typeof req.onFail === "function") {
    req.onFail(function (err) {
      var msg = err ? ((err.code ? err.code + ": " : "") + (err.message || String(err))) : "unknown error";
      bru.setVar("outcome", JSON.stringify({ request: "Redirect h2 server to h1-only server", ok: false, error: msg }));
    });
  }
}

script:post-response {
  var __b = res.getBody();
  var __j = {};
  if (typeof __b === "string") { try { __j = JSON.parse(__b); } catch (e) { __j = {}; } } else { __j = __b || {}; }
  bru.setVar("outcome", JSON.stringify({
    request: "Redirect h2 server to h1-only server",
    ok: true,
    status: res.getStatus(),
    protocol: res.getHeader("x-protocol") || __j.protocol || null,
    server: res.getHeader("x-server") || __j.server || null,
    connectionId: res.getHeader("x-connection-id") || null,
    echoHeaders: __j.headers || null,
    bodyPreview: (typeof __b === "string" ? __b : JSON.stringify(__b) || "").slice(0, 300)
  }));
}

settings {
  encodeUrl: true
}

docs {
  Hop 1 goes to dual (h2 in http2/auto), hop 2 to h1only. In **auto**, hop 2 must switch to HTTP/1.1 (Timeline: a second `HTTP/1.1 selected` line). In **http2**, hop 2 must fail clearly.
  
  > **Outcome case.** This request may fail *by design*. Its result is recorded in the runtime var `outcome` and asserted by the next request, **↳ verify: Redirect h2 server to h1-only server**. Run both together (the folder runner does this).
}
