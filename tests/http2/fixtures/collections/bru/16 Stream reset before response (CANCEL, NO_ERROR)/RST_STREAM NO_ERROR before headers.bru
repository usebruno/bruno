script:pre-request {
  bru.setVar("outcome", JSON.stringify({ request: "RST_STREAM NO_ERROR before headers", ok: false, error: "no response (request failed before post-response ran)" }));
  if (typeof req.onFail === "function") {
    req.onFail(function (err) {
      var msg = err ? ((err.code ? err.code + ": " : "") + (err.message || String(err))) : "unknown error";
      bru.setVar("outcome", JSON.stringify({ request: "RST_STREAM NO_ERROR before headers", ok: false, error: msg }));
    });
  }
}

script:post-response {
  var __b = res.getBody();
  var __j = {};
  if (typeof __b === "string") { try { __j = JSON.parse(__b); } catch (e) { __j = {}; } } else { __j = __b || {}; }
  bru.setVar("outcome", JSON.stringify({
    request: "RST_STREAM NO_ERROR before headers",
    ok: true,
    status: res.getStatus(),
    protocol: res.getHeader("x-protocol") || __j.protocol || null,
    server: res.getHeader("x-server") || __j.server || null,
