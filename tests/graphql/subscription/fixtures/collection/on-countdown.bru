meta {
  name: on-countdown
  type: graphql-subscription
  seq: 1
}

graphql:subscription {
  url: ws://localhost:8081/api/graphql
  auth: none
}

headers {
}

body:graphql {
  subscription OnCountdown { countdown { count } }
}

body:graphql:vars {
  {}
}

settings {
  timeout: 0
  keepAliveInterval: 0
}
