{
  "name": "@usebruno/sqlite",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "dist/node/cjs/index.js",
  "module": "dist/node/esm/index.js",
  "types": "dist/node/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "require": "./dist/node/cjs/index.js",
      "import": "./dist/node/esm/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "require": "./dist/node/cjs/index.js",
      "import": "./dist/node/esm/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "package.json"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "generate": "tsx scripts/generate-artifacts.ts",
    "prepare": "npm run generate",
    "prebuild": "npm run clean && npm run generate",
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "pretest": "npm run generate",
    "test": "cross-env NODE_OPTIONS=\"--experimental-sqlite\" jest",
    "test:watch": "cross-env NODE_OPTIONS=\"--experimental-sqlite\" jest --watch",
    "prepack": "npm run test && npm run build",
    "migration:new": "tsx scripts/new-migration.ts",
    "schema": "cross-env NODE_OPTIONS=\"--experimental-sqlite\" tsx scripts/generate-schema.ts",
    "migration:verify": "cross-env NODE_OPTIONS=\"--experimental-sqlite\" tsx --env-file=.env scripts/verify-migrations.ts"
  },
  "devDependencies": {
    "@babel/preset-env": "7.26.0",
    "@babel/preset-typescript": "7.28.5",
    "@rollup/plugin-commonjs": "23.0.7",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "15.3.1",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.1.2",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.17",
    "babel-jest": "29.7.0",
    "cross-env": "10.1.0",
    "jest": "29.7.0",
    "rimraf": "6.0.1",
    "rollup": "3.30.0",
    "rollup-plugin-dts": "5.3.1",
    "typescript": "4.9.5",
    "tsx": "4.22.4"
  },
  "overrides": {
    "rollup": "3.30.0"
  },
  "dependencies": {}
}
